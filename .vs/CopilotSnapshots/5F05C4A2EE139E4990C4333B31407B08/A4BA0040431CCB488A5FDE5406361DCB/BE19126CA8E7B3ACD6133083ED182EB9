import requests
import os
import time
from datetime import datetime

# ======================
# 你的 Cookie（完全不变）
# ======================
FedAuth = ""
rtFa = ""

# 基础配置
site_url = "https://cmgos.sharepoint.cn/sites/RD"
folder_path = "/sites/RD/Shared Documents"
excluded_folder_names = {"王晓峰"}

# 会话
session = requests.Session()
session.cookies.set("FedAuth", FedAuth)
session.cookies.set("rtFa", rtFa)

headers = {
    "Accept": "application/json;odata=nometadata",
    "User-Agent": "Mozilla/5.0"
}

all_items = []

# ==============================================
# 1. 获取 主目录文件夹（你原来的代码，完全不变）
# ==============================================
try:
    folder_api = f"{site_url}/_api/web/getfolderbyserverrelativeurl('{folder_path}')/folders"
    resp = session.get(folder_api, headers=headers)
    if resp.status_code == 200:
        folders = resp.json().get("value", [])
        for f in folders:
            name = f.get("Name", "")
            if name and name not in ["Forms", ""]:
                all_items.append(f"📂 {name}")
except:
    pass

# ==============================================
# 2. 获取 主目录文件（你原来的代码，完全不变）
# ==============================================
try:
    file_api = f"{site_url}/_api/web/getfolderbyserverrelativeurl('{folder_path}')/files"
    resp = session.get(file_api, headers=headers)
    if resp.status_code == 200:
        files = resp.json().get("value", [])
        for f in files:
            name = f.get("Name", "")
            if name:
                all_items.append(f"📄 {name}")
except:
    pass

# ==============================================
# 输出 主目录 结果（你原来的展示，完全不变）
# ==============================================
print("=" * 70)
print("📂 主目录：Shared Documents")
print("=" * 70)

for i, item in enumerate(sorted(all_items), 1):
    print(f"{i:2d}. {item}")

print(f"\n✅ 主目录共找到：{len(all_items)} 个项目！")

# ==============================================
# 👇 👇 👇 进入子文件夹：17.B包环境和操作历史状态
# ==============================================
print("\n" + "=" * 70)
print("📂 进入子文件夹：17.B包环境和操作历史状态")
print("=" * 70)

root_sub_folder = "/sites/RD/Shared Documents/17.B包环境和操作历史状态"
sub_folders = []  # 所有子文件夹：刘晴、周利明、王晓峰、茹小龙
all_files_to_download = []

# ------------------------------
# 第一步：获取一级子文件夹列表
# ------------------------------
try:
    resp = session.get(f"{site_url}/_api/web/getfolderbyserverrelativeurl('{root_sub_folder}')/folders", headers=headers)
    if resp.status_code == 200:
        for f in resp.json().get("value", []):
            name = f.get("Name", "")
            path = f.get("ServerRelativeUrl", "")
            if name and name not in ["Forms"] and name not in excluded_folder_names:
                sub_folders.append({"name": name, "path": path})
                print(f"📂 {name}")
            elif name in excluded_folder_names:
                print(f"⏭️ 已跳过文件夹：{name}")
except:
    pass

print(f"\n✅ 子文件夹共找到：{len(sub_folders)} 个！")

# ==============================================
# 👇 👇 👇 【核心新增】递归下载所有子文件夹里的文件
# ==============================================
print("\n" + "=" * 70)
print("📂 开始递归下载所有子文件夹内的文件到 D 盘")
print("=" * 70)

# 1. 创建本地根目录
base_local = r"D:\UpdateLogAuditTool_Log"
time_folder = datetime.now().strftime("%Y%m%d%H%M")
root_local = os.path.join(base_local, time_folder)
os.makedirs(root_local, exist_ok=True)
print(f"📁 本地根目录：{root_local}\n")

total_success = 0

# 2. 遍历每个子文件夹（刘晴 / 周利明 / ...）
for user_folder in sub_folders:
    folder_name = user_folder["name"]
    folder_sp_path = user_folder["path"]
    
    print(f"正在处理：{folder_name}")
    
    # 创建本地同名文件夹
    local_user_folder = os.path.join(root_local, folder_name)
    os.makedirs(local_user_folder, exist_ok=True)
    
    # 获取该用户文件夹下的所有文件
    try:
        file_url = f"{site_url}/_api/web/getfolderbyserverrelativeurl('{folder_sp_path}')/files"
        resp = session.get(file_url, headers=headers)
        if resp.status_code == 200:
            files = resp.json().get("value", [])
            for file in files:
                name = file["Name"]
                server_url = file["ServerRelativeUrl"]
                
                # 下载
                local_path = os.path.join(local_user_folder, name)
                try:
                    r = session.get(f"https://cmgos.sharepoint.cn{server_url}", stream=True)
                    with open(local_path, "wb") as f:
                        for chunk in r.iter_content(1024):
                            f.write(chunk)
                    print(f"  ✅ 已下载：{name}")
                    total_success += 1
                except:
                    print(f"  ❌ 下载失败：{name}")
    except:
        print(f"  ⚠️  读取失败")

# ==============================================
# 最终完成提示
# ==============================================
print("\n" + "=" * 70)
print(f"🎉 全部拷贝完成！共下载文件：{total_success} 个")
print(f"📂 所有文件保存在：{root_local}")
print("=" * 70)

print("\n✅ 程序全部执行完成！")