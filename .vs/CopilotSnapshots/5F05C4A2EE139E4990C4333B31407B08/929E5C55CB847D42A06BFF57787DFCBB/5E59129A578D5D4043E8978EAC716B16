import os
import sys
from urllib.parse import urlparse

import win32cred

from office365.azure_env import AzureEnvironment
from office365.runtime.auth.user_credential import UserCredential
from office365.sharepoint.client_context import ClientContext


CREDENTIAL_TARGET = "cmgos-my.sharepoint.cn"
SITE_URL = "https://cmgos.sharepoint.cn/sites/RD"
FOLDER_PATH = "/Shared Documents"
TARGET_SUBFOLDER = "17.B\u5305\u73af\u5883\u548c\u64cd\u4f5c\u5386\u53f2\u72b6\u6001"

# If legacy username/password auth fails, fill these in or set environment variables:
#   SPO_TENANT=yourtenant.partner.onmschina.cn
#   SPO_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
TENANT_NAME = os.getenv("SPO_TENANT", "")
CLIENT_ID = os.getenv("SPO_CLIENT_ID", "")
AUTH_MODE = os.getenv("SPO_AUTH_MODE", "auto").strip().lower()


def read_windows_credential(target_name: str) -> tuple[str, str]:
    credential = None
    for cred_type in (win32cred.CRED_TYPE_GENERIC, win32cred.CRED_TYPE_DOMAIN_PASSWORD):
        try:
            credential = win32cred.CredRead(target_name, cred_type)
            break
        except Exception:
            continue

    if credential is None:
        raise ValueError(f"Windows credential '{target_name}' was not found")

    username = credential.get("UserName")
    password_blob = credential.get("CredentialBlob", b"")

    if not username:
        raise ValueError(f"Windows credential '{target_name}' does not contain a username")

    if isinstance(password_blob, bytes):
        try:
            password = password_blob.decode("utf-16-le").rstrip("\x00")
        except UnicodeDecodeError:
            password = password_blob.decode(errors="ignore").rstrip("\x00")
    else:
        password = str(password_blob)

    if not password:
        raise ValueError(f"Windows credential '{target_name}' does not contain a password")

    return username, password


def create_legacy_context(site_url: str, username: str, password: str) -> ClientContext:
    return ClientContext(site_url, environment=AzureEnvironment.China).with_credentials(
        UserCredential(username, password)
    )


def create_device_flow_context(site_url: str, tenant_name: str, client_id: str) -> ClientContext:
    return ClientContext(site_url, environment=AzureEnvironment.China).with_device_flow(
        tenant_name, client_id
    )


def create_interactive_context(site_url: str, tenant_name: str, client_id: str) -> ClientContext:
    return ClientContext(site_url, environment=AzureEnvironment.China).with_interactive(
        tenant_name, client_id
    )


def build_target_relative_url(site_url: str, folder_path: str, subfolder_name: str) -> str:
    site_path = urlparse(site_url).path.rstrip("/")
    return f"{site_path}{folder_path}/{subfolder_name}"


def print_folder_tree(folder, indent: int = 0) -> None:
    prefix = "    " * indent
    folder_name = folder.name or "(unnamed folder)"
    print(f"{prefix}[Folder] {folder_name}")

    child_folders = folder.folders.get().execute_query()
    files = folder.files.get().execute_query()

    for child_folder in child_folders:
        print_folder_tree(child_folder, indent + 1)

    for file_item in files:
        print(f"{'    ' * (indent + 1)}[File] {file_item.name}")


def test_and_get_folder(ctx: ClientContext, target_relative_url: str):
    folder = ctx.web.get_folder_by_server_relative_url(target_relative_url)
    ctx.load(folder, ["Name", "ServerRelativeUrl"])
    folder.execute_query()
    return folder


def try_legacy_auth(site_url: str, target_relative_url: str):
    username, password = read_windows_credential(CREDENTIAL_TARGET)
    ctx = create_legacy_context(site_url, username, password)
    folder = test_and_get_folder(ctx, target_relative_url)
    return "legacy", ctx, folder


def try_device_flow_auth(site_url: str, target_relative_url: str):
    if not TENANT_NAME or not CLIENT_ID:
        raise ValueError(
            "Device flow auth requires SPO_TENANT and SPO_CLIENT_ID environment variables"
        )
    ctx = create_device_flow_context(site_url, TENANT_NAME, CLIENT_ID)
    folder = test_and_get_folder(ctx, target_relative_url)
    return "device_flow", ctx, folder


def try_interactive_auth(site_url: str, target_relative_url: str):
    if not TENANT_NAME or not CLIENT_ID:
        raise ValueError(
            "Interactive auth requires SPO_TENANT and SPO_CLIENT_ID environment variables"
        )
    ctx = create_interactive_context(site_url, TENANT_NAME, CLIENT_ID)
    folder = test_and_get_folder(ctx, target_relative_url)
    return "interactive", ctx, folder


def authenticate(site_url: str, target_relative_url: str):
    attempts = []

    if AUTH_MODE == "legacy":
        attempts = [("legacy", try_legacy_auth)]
    elif AUTH_MODE == "device":
        attempts = [("device_flow", try_device_flow_auth)]
    elif AUTH_MODE == "interactive":
        attempts = [("interactive", try_interactive_auth)]
    else:
        attempts = [
            ("legacy", try_legacy_auth),
            ("device_flow", try_device_flow_auth),
            ("interactive", try_interactive_auth),
        ]

    errors = []
    for name, auth_func in attempts:
        try:
            print(f"Trying auth mode: {name}")
            return auth_func(site_url, target_relative_url)
        except Exception as ex:
            message = f"{name}: {ex}"
            errors.append(message)
            print(f"Auth mode failed -> {message}", file=sys.stderr)

    raise RuntimeError("All authentication methods failed:\n- " + "\n- ".join(errors))


def print_auth_help() -> None:
    print("", file=sys.stderr)
    print("Hints:", file=sys.stderr)
    print("1. If legacy auth fails, your tenant likely requires modern authentication.", file=sys.stderr)
    print("2. For modern auth, register an app in the China tenant and set:", file=sys.stderr)
    print("   SPO_TENANT=<your tenant domain>", file=sys.stderr)
    print("   SPO_CLIENT_ID=<your app client id>", file=sys.stderr)
    print("3. Optional: set SPO_AUTH_MODE=device or SPO_AUTH_MODE=interactive", file=sys.stderr)
    print("4. Interactive auth requires a public client redirect URI like http://localhost", file=sys.stderr)


def main() -> int:
    try:
        target_relative_url = build_target_relative_url(SITE_URL, FOLDER_PATH, TARGET_SUBFOLDER)
        auth_mode, _ctx, folder = authenticate(SITE_URL, target_relative_url)

        print(f"Auth mode used: {auth_mode}")
        print(f"Site: {SITE_URL}")
        print(f"Target folder: {folder.serverRelativeUrl}")
        print_folder_tree(folder)
        return 0
    except Exception as ex:
        print(f"Execution failed: {ex}", file=sys.stderr)
        print_auth_help()
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
