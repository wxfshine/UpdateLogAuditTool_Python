{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cmit.local/schemas/swimlane-schema.json",
  "title": "Swimlane Diagram Data Schema",
  "type": "object",
  "required": ["meta", "roles", "stages", "branches", "nodes", "edges"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["id", "version", "defaultLocale", "supportedLocales", "title"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "defaultLocale": { "type": "string", "minLength": 1 },
        "supportedLocales": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "title": { "$ref": "#/$defs/localizedText" },
        "description": { "$ref": "#/$defs/localizedText" }
      },
      "additionalProperties": false
    },
    "roles": {
      "type": "array",
      "items": { "$ref": "#/$defs/role" },
      "uniqueItems": false
    },
    "stages": {
      "type": "array",
      "items": { "$ref": "#/$defs/stage" },
      "uniqueItems": false
    },
    "branches": {
      "type": "array",
      "items": { "$ref": "#/$defs/branch" },
      "uniqueItems": false
    },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" },
      "uniqueItems": false
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" },
      "uniqueItems": false
    },
    "artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifact" },
      "default": []
    }
  },
  "additionalProperties": false,
  "$defs": {
    "localizedText": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "minLength": 2
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "localizedTextArrayItem": {
      "anyOf": [
        { "type": "string" },
        { "$ref": "#/$defs/localizedText" }
      ]
    },
    "role": {
      "type": "object",
      "required": ["id", "name", "order"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "$ref": "#/$defs/localizedText" },
        "shortName": { "$ref": "#/$defs/localizedText" },
        "order": { "type": "integer", "minimum": 1 },
        "description": { "$ref": "#/$defs/localizedText" }
      },
      "additionalProperties": false
    },
    "stage": {
      "type": "object",
      "required": ["id", "name", "order"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "$ref": "#/$defs/localizedText" },
        "order": { "type": "integer", "minimum": 1 },
        "description": { "$ref": "#/$defs/localizedText" }
      },
      "additionalProperties": false
    },
    "branch": {
      "type": "object",
      "required": ["id", "stageId", "name", "order"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "stageId": { "type": "string", "minLength": 1 },
        "name": { "$ref": "#/$defs/localizedText" },
        "order": { "type": "integer", "minimum": 1 },
        "description": { "$ref": "#/$defs/localizedText" }
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": ["id", "roleId", "stageId", "branchId", "order", "type", "title"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "roleId": { "type": "string", "minLength": 1 },
        "stageId": { "type": "string", "minLength": 1 },
        "branchId": { "type": "string", "minLength": 1 },
        "order": { "type": "integer", "minimum": 1 },
        "type": {
          "type": "string",
          "enum": ["task", "review", "decision", "milestone", "output"]
        },
        "title": { "$ref": "#/$defs/localizedText" },
        "description": { "$ref": "#/$defs/localizedText" },
        "outputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/localizedTextArrayItem" },
          "default": []
        },
        "outputIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "default": []
        },
        "status": {
          "type": "string",
          "enum": ["planned", "active", "completed", "blocked"],
          "default": "planned"
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "url"],
            "properties": {
              "label": { "$ref": "#/$defs/localizedText" },
              "url": { "type": "string", "format": "uri" }
            },
            "additionalProperties": false
          },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "required": ["id", "from", "to", "type"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": ["sequence", "handoff", "dependency", "feedback"]
        },
        "label": { "$ref": "#/$defs/localizedText" }
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": ["id", "name", "type"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "$ref": "#/$defs/localizedText" },
        "type": { "type": "string", "minLength": 1 },
        "description": { "$ref": "#/$defs/localizedText" }
      },
      "additionalProperties": false
    }
  }
}
